# ==============================================================================
# 第十师瓜子油料数字化交易平台 —— 部署环境变量模板
# 用法：
#   cd deploy
#   cp .env.example .env      # Windows: copy .env.example .env
#   然后【务必】修改下面所有标注"请务必修改"的密码与密钥
#   docker compose up -d --build
# ------------------------------------------------------------------------------
# 安全提示：
#   1) .env 已在 deploy/.gitignore 中忽略，禁止提交到代码仓库。
#   2) 下面给出的默认值仅用于"一键启动/演示"，正式环境必须全部更换，
#      并交给密钥管理系统（1Password/Vault/堡垒机）保管。
#   3) 密码若包含 @ : / ? # & 等特殊字符，写进 *_URL 连接串时必须做
#      URL 编码（例如 @ -> %40），否则 SQLAlchemy/redis-py 会解析失败。
#      为降低踩坑概率，默认值一律使用字母数字下划线。
#   4) 生产环境请勿把 POSTGRES/ES/MinIO 端口暴露到公网。
# ------------------------------------------------------------------------------
# 模板版本：v1（2024）。新增变量请同步更新 deploy/README.md 与 compose 文件。
# ==============================================================================

# ============================== 通用 ==========================================
# 时区：容器内统一使用东八区，避免报表与单据时间偏移
TZ=Asia/Shanghai
# 运行环境标识：production / staging / development
APP_ENV=production
# API 调试开关：生产必须为 false（true 会返回堆栈细节）
DEBUG=false

# ============================ PostgreSQL 16 ===================================
# 超级用户（initdb 创建，同时是 gz_odoo / gz_platform / superset 三库的属主）
POSTGRES_USER=gz
# 【请务必修改】PostgreSQL 超级用户密码
POSTGRES_PASSWORD=gz_pg_change_me_2024
# 默认连接库（compose 的 healthcheck 用它做探测）
POSTGRES_DB=gz_platform
# Odoo 业务库
ODOO_DB=gz_odoo
# 自研平台库（业务表位于 schema gz）
PLATFORM_DB=gz_platform
# Superset 元数据库
SUPERSET_DB=superset
# 只读报表账号：供 Superset 查询 gz_platform / gz_odoo 使用
# 【请务必修改】并与 conf/postgres/init/02-readonly.sql 中硬编码的默认值保持一致；
# 若改过 SQL 中的密码，请按 conf/postgres/init/02-readonly.sql 顶部注释手工执行 ALTER ROLE。
POSTGRES_READONLY_USER=gz_ro
POSTGRES_READONLY_PASSWORD=gz_ro_change_me
# 仅在需要从宿主机用 psql/DBeaver 调试时启用（compose 中默认注释掉 5432 映射）
POSTGRES_HOST_PORT=5432

# ================================ Redis 7 =====================================
# 【请务必修改】Redis 访问密码（requirepass）
REDIS_PASSWORD=gz_redis_change_me_2024
# 仅在需要从宿主机调试时启用
REDIS_HOST_PORT=6379

# ================================ MinIO =======================================
# 【请务必修改】MinIO 管理账号（至少 3 位）与密码（至少 8 位）
MINIO_ROOT_USER=gzminio
MINIO_ROOT_PASSWORD=gz_minio_change_me_2024
# 平台默认使用的对象存储桶（商品图片、检测报告等）
# 其余业务桶 gz-report / gz-contract / gz-trace 由 minio-init 自动创建
MINIO_BUCKET=gz-product
# 前端/宿主访问 MinIO 的地址：容器内部访问用服务名，浏览器预签名 URL 用宿主地址
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
# 浏览器打开 MinIO 控制台时跳转的地址（部署到服务器后改成实际域名/IP）
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================ ElasticSearch 8 =================================
# 容器内统一用服务名访问；ES 关闭安全认证（仅内网），如需开启请同步改此处
ELASTICSEARCH_URL=http://elasticsearch:9200
# ES JVM 堆：生产最小集 1g；开发机内存紧张可降到 -Xms512m -Xmx512m
# 注意：ES 对内存敏感，建议宿主内存 >= 8G 时再按 1g 配置
ES_JAVA_OPTS=-Xms1g -Xmx1g
ES_HOST_PORT=9200

# ============================ Odoo 17 (CE) ====================================
# 【请务必修改】Odoo 数据库管理主密码（用于创建/备份/还原数据库）
ODOO_ADMIN_PASSWD=odoo_master_change_me
# Odoo 内置管理员登录名（密码在首次初始化时通过 ADMIN_PASSWD/界面设置）
ODOO_ADMIN_USER=admin
# Odoo 网页/JSON-RPC 登录密码；与数据库管理主密码 ODOO_ADMIN_PASSWD 不同
ODOO_LOGIN_PASSWORD=<set-in-production>
# Odoo 服务端口与长轮询（websocket）端口
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
# Odoo worker 进程数：经验值 = CPU 核数/2 + 1；8 核机器建议 4，开发机建议 1
ODOO_WORKERS=2
# 定时任务线程数（结算跑批、超时关闭询价等）
ODOO_MAX_CRON_THREADS=2
# 单请求 CPU / 墙钟时间上限（秒）
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200
# 是否在登录页显示数据库列表（生产建议 False，避免暴露库名）
ODOO_LIST_DB=True
# 不安装演示数据（all 表示全部模块都不装 demo，生产建议保持 all）
ODOO_WITHOUT_DEMO=all
# 自建 Odoo 镜像名（对应 ../odoo 构建产物）
ODOO_IMAGE=gz-odoo:17
# 容器内访问 Odoo 的地址（供 API 调用 JSON-RPC）
ODOO_URL=http://odoo:8069
# 说明：Odoo 官方镜像的 entrypoint 不支持通过环境变量注入 SMTP 与 dbfilter，
#       这两类配置请在 Odoo 界面「设置 -> 技术 -> 系统参数 / 邮件服务器」中配置。

# ======================== 自研平台 API / Worker ===============================
# 【请务必修改】以下三个密钥请分别生成不同的随机串（切勿重复使用）
#   生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# API_SECRET_KEY：接口签名/内部校验用
API_SECRET_KEY=api_secret_change_me_9f2b7c41d8e35a60
# JWT_SECRET：JWT(HS256) 签发密钥，泄漏等于全平台身份可伪造
JWT_SECRET=jwt_secret_change_me_4a71ce90b3f8d265
# INTEGRATION_SECRET：与 Odoo 集成/回调的共享密钥（校验 outbox 回调来源）
INTEGRATION_SECRET=integration_secret_change_me_6d18ba43f7c209e5
# 访问令牌有效期（分钟）与刷新令牌有效期（天），与 docs/04-接口规范.md 保持一致
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
# 平台服务费率（按订单金额计提），0.005 = 0.5%
PLATFORM_SERVICE_FEE_RATE=0.005
# 自建 API 镜像名前缀（api 与 worker 共用同一镜像）
API_IMAGE=gz-api:latest
# 宿主调试 API 用端口（正常经 nginx 的 GATEWAY_PORT 访问）
API_PORT=8000

# ------------------------- 连接串 --------------------------------------------
# 说明：Docker Compose 只对 .env 做一层 ${VAR} 替换，不做递归嵌套替换，
#       因此下面几行必须写"字面值"，不要写成 ${POSTGRES_USER} 这种引用；
#       若你改了上面的账号/密码/库名，请手动同步下面这几行。
# 自研平台连接串：search_path 由 API 引擎自动注入（core/database.py 会为 postgresql 连接
#   追加 options=-csearch_path=gz,public），因此这里**不要**再写 options，避免重复设置。
#   · 驱动后缀必须写 postgresql+psycopg:// —— services/api/requirements.txt 安装的是
#     psycopg3（psycopg[binary]）；若只写 postgresql://，SQLAlchemy 默认去找 psycopg2，
#     而镜像里没有 psycopg2，会直接启动失败。
DATABASE_URL=postgresql+psycopg://gz:gz_pg_change_me_2024@postgres:5432/gz_platform
# Redis 连接串（/0 库；密码如有特殊字符需 URL 编码）
REDIS_URL=redis://:gz_redis_change_me_2024@redis:6379/0

# ================================ Superset ====================================
# 【请务必修改】Superset 会话加密密钥（一旦修改，已保存的数据源密码需重新录入）
#   生成方式：openssl rand -base64 42
SUPERSET_SECRET_KEY=superset_secret_change_me_2f8c15a7be4093d6
# 【请务必修改】Superset 管理员账号
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=superset_admin_change_me
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_FIRSTNAME=平台
SUPERSET_ADMIN_LASTNAME=管理员
SUPERSET_PORT=8088
# Superset 元数据库连接串（psycopg2 驱动，镜像自带）
SUPERSET_DATABASE_URI=postgresql+psycopg2://gz:gz_pg_change_me_2024@postgres:5432/superset
# Superset 查询业务库使用的只读连接串（报表专用，禁止用超级用户）
SUPERSET_PLATFORM_URI=postgresql://gz_ro:gz_ro_change_me@postgres:5432/gz_platform
SUPERSET_ODOO_URI=postgresql://gz_ro:gz_ro_change_me@postgres:5432/gz_odoo

# ============================= 前端管理后台 ====================================
# 自建前端镜像名（对应 ../apps/admin-web 构建产物）
ADMIN_WEB_IMAGE=gz-admin-web:latest

# ============================ Nginx 统一网关 ==================================
# 综合入口（PC 管理后台 / 、移动端 H5 /m/ 、运维控制台 /console/ 、API /api ）
#   局域网访问：http://<电脑IP>:8080     本机：http://localhost:8080
GATEWAY_PORT=8080
# 管理后台专用入口（与 GATEWAY_PORT 指向同一站点，便于按端口区分前台与后台）
#   局域网访问：http://<电脑IP>:8081
ADMIN_PORT=8081
# 手机端入口（由网关转发到 H5，无需安装 APP）
#   局域网访问：http://<电脑IP>:8080/m/
MOBILE_PATH=/m/

# ======================= 局域网（LAN）部署相关 ================================
# 所有服务均监听 0.0.0.0，容器端口通过下列变量发布到宿主机的全部网卡，
# 同一局域网内的电脑与手机可直接用"电脑IP:端口"访问，无需修改任何配置。
# 若宿主机有多张网卡需要限定监听地址，可把 ports 改为 "192.168.1.100:8080:80"。
# 启动后运行 deploy/scripts/access-info.ps1（Windows）或 access-info.sh（Linux/macOS）
# 会自动探测本机局域网 IP 并打印完整访问地址清单。
# 允许跨域来源（默认 * 便于局域网任意设备调试；生产建议收敛为具体域名/IP）
CORS_ORIGINS=*

