<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         询价单：列表
         ================================================================== -->
    <record id="view_gz_inquiry_tree" model="ir.ui.view">
        <field name="name">gz.inquiry.tree</field>
        <field name="model">gz.inquiry</field>
        <field name="arch" type="xml">
            <tree string="询价单"
                  decoration-danger="state == 'cancelled'"
                  decoration-success="state == 'confirmed'"
                  decoration-info="state == 'submitted'">
                <field name="name"/>
                <field name="buyer_enterprise_id"/>
                <field name="supplier_enterprise_id" optional="show"/>
                <field name="product_id"/>
                <field name="quantity" sum="合计数量"/>
                <field name="unit" optional="hide"/>
                <field name="expect_price" optional="show"/>
                <field name="currency_id" invisible="1"/>
                <field name="expect_delivery_date" optional="hide"/>
                <field name="quoted_count" optional="show"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ==================================================================
         询价单：表单
         ================================================================== -->
    <record id="view_gz_inquiry_form" model="ir.ui.view">
        <field name="name">gz.inquiry.form</field>
        <field name="model">gz.inquiry</field>
        <field name="arch" type="xml">
            <form string="询价单">
                <header>
                    <button name="action_submit" type="object" string="提交询价"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="关闭"
                            invisible="state in ('cancelled', 'closed', 'draft')"/>
                    <button name="action_cancel" type="object" string="取消"
                            invisible="state in ('cancelled', 'closed', 'confirmed')"
                            groups="gz_platform_base.group_gz_platform_admin,gz_platform_base.group_gz_park_operator,gz_platform_base.group_gz_merchant,gz_platform_base.group_gz_buyer"/>
                    <button name="action_reset_draft" type="object" string="撤回草稿"
                            invisible="state in ('draft', 'confirmed', 'closed')"
                            groups="gz_platform_base.group_gz_platform_admin,gz_platform_base.group_gz_park_operator"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,quoted,confirmed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotations" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="quoted_count" widget="statinfo" string="报价数"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="询价单号"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="主体">
                            <field name="buyer_enterprise_id" options="{'no_create': True}"/>
                            <field name="supplier_enterprise_id" options="{'no_create': True}"/>
                        </group>
                        <group string="商品与时间">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="unit"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="expect_price"/>
                            <field name="expect_delivery_date"/>
                            <field name="delivery_address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="报价单" name="gz_quotations">
                            <field name="quotation_ids" nolabel="1"
                                   context="{'default_inquiry_id': id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="supplier_enterprise_id"/>
                                    <field name="unit_price"/>
                                    <field name="amount" sum="合计金额"/>
                                    <field name="tax_rate"/>
                                    <field name="valid_until"/>
                                    <field name="state" widget="badge"/>
                                    <field name="order_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="备注" name="gz_remark">
                            <field name="remark" placeholder="质量要求、结算方式、装运要求等"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ==================================================================
         询价单：搜索
         ================================================================== -->
    <record id="view_gz_inquiry_search" model="ir.ui.view">
        <field name="name">gz.inquiry.search</field>
        <field name="model">gz.inquiry</field>
        <field name="arch" type="xml">
            <search string="询价单">
                <field name="name"/>
                <field name="buyer_enterprise_id"/>
                <field name="supplier_enterprise_id"/>
                <field name="product_id"/>
                <field name="delivery_address"/>
                <filter name="filter_draft" string="草稿" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="待报价" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_quoted" string="已报价" domain="[('state', '=', 'quoted')]"/>
                <filter name="filter_confirmed" string="已确认" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="filter_my_company" string="与我相关"
                        domain="['|', ('buyer_enterprise_id.partner_id', '=', uid), ('supplier_enterprise_id.partner_id', '=', uid)]"/>
                <group expand="0" string="分组">
                    <filter name="group_state" string="状态" context="{'group_by': 'state'}"/>
                    <filter name="group_buyer" string="采购企业" context="{'group_by': 'buyer_enterprise_id'}"/>
                    <filter name="group_supplier" string="供应商" context="{'group_by': 'supplier_enterprise_id'}"/>
                    <filter name="group_product" string="商品" context="{'group_by': 'product_id'}"/>
                    <filter name="group_create_date" string="创建日期" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================================================================
         询价单：动作
         ================================================================== -->
    <record id="action_gz_inquiry" model="ir.actions.act_window">
        <field name="name">询价单</field>
        <field name="res_model">gz.inquiry</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_gz_inquiry_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有询价单</p>
            <p>采购商在自研平台发起询价，平台侧同步为询价单镜像；供应商报价后由采购商接受生成订单。</p>
        </field>
    </record>

</odoo>
