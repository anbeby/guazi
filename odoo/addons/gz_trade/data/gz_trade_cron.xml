<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ==============================================================
             平台订单进度同步（每 30 分钟）
             Odoo 17 的 ir.cron 基于 ir.actions.server（delegate），
             因此在同一条记录上直接写 model_id / state / code。
             方法内部对平台不可用做 try/except 容错，不会中断定时任务。
             ============================================================== -->
        <record id="ir_cron_gz_order_sync_platform" model="ir.cron">
            <field name="name">瓜子油料：平台订单进度同步（每 30 分钟）</field>
            <field name="model_id" ref="model_gz_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_platform()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
