<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         记录规则：企业级数据隔离
         平台管理员 / 园区运营 / 财务不加限制（由 ir.model.access.csv 控制读写），
         商户 / 供应商 / 采购商仅可见本企业作为买方或卖方的交易数据。
         ================================================================== -->
    <record id="rule_gz_inquiry_own_company" model="ir.rule">
        <field name="name">询价单：仅见本企业（公开询价对供应商可见）</field>
        <field name="model_id" ref="model_gz_inquiry"/>
        <field name="domain_force">['|', '|', '|', ('buyer_enterprise_id.partner_id', '=', user.partner_id.id), ('supplier_enterprise_id.partner_id', '=', user.partner_id.id), ('supplier_enterprise_id', '=', False), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('gz_platform_base.group_gz_merchant')), (4, ref('gz_platform_base.group_gz_supplier')), (4, ref('gz_platform_base.group_gz_buyer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_gz_quotation_own_company" model="ir.rule">
        <field name="name">报价单：仅见本企业（供应商报价 / 采购商查看本单报价）</field>
        <field name="model_id" ref="model_gz_quotation"/>
        <field name="domain_force">['|', ('supplier_enterprise_id.partner_id', '=', user.partner_id.id), ('inquiry_id.buyer_enterprise_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('gz_platform_base.group_gz_merchant')), (4, ref('gz_platform_base.group_gz_supplier')), (4, ref('gz_platform_base.group_gz_buyer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_gz_order_own_company" model="ir.rule">
        <field name="name">平台订单：仅见本企业（买方或卖方）</field>
        <field name="model_id" ref="model_gz_order"/>
        <field name="domain_force">['|', ('buyer_enterprise_id.partner_id', '=', user.partner_id.id), ('supplier_enterprise_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('gz_platform_base.group_gz_merchant')), (4, ref('gz_platform_base.group_gz_supplier')), (4, ref('gz_platform_base.group_gz_buyer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_gz_order_line_own_company" model="ir.rule">
        <field name="name">平台订单明细：仅见本企业订单</field>
        <field name="model_id" ref="model_gz_order_line"/>
        <field name="domain_force">['|', ('order_id.buyer_enterprise_id.partner_id', '=', user.partner_id.id), ('order_id.supplier_enterprise_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('gz_platform_base.group_gz_merchant')), (4, ref('gz_platform_base.group_gz_supplier')), (4, ref('gz_platform_base.group_gz_buyer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_gz_order_timeline_own_company" model="ir.rule">
        <field name="name">订单轨迹：仅见本企业订单</field>
        <field name="model_id" ref="model_gz_order_timeline"/>
        <field name="domain_force">['|', ('order_id.buyer_enterprise_id.partner_id', '=', user.partner_id.id), ('order_id.supplier_enterprise_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('gz_platform_base.group_gz_merchant')), (4, ref('gz_platform_base.group_gz_supplier')), (4, ref('gz_platform_base.group_gz_buyer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_gz_contract_own_company" model="ir.rule">
        <field name="name">平台合同：仅见本企业合同</field>
        <field name="model_id" ref="model_gz_contract"/>
        <field name="domain_force">['|', ('buyer_enterprise_id.partner_id', '=', user.partner_id.id), ('supplier_enterprise_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('gz_platform_base.group_gz_merchant')), (4, ref('gz_platform_base.group_gz_supplier')), (4, ref('gz_platform_base.group_gz_buyer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_gz_settlement_own_company" model="ir.rule">
        <field name="name">结算单：仅见本企业结算单</field>
        <field name="model_id" ref="model_gz_settlement"/>
        <field name="domain_force">[('enterprise_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('gz_platform_base.group_gz_merchant')), (4, ref('gz_platform_base.group_gz_supplier')), (4, ref('gz_platform_base.group_gz_buyer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_gz_settlement_line_own_company" model="ir.rule">
        <field name="name">结算明细：仅见本企业结算单明细</field>
        <field name="model_id" ref="model_gz_settlement_line"/>
        <field name="domain_force">[('settlement_id.enterprise_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('gz_platform_base.group_gz_merchant')), (4, ref('gz_platform_base.group_gz_supplier')), (4, ref('gz_platform_base.group_gz_buyer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_gz_trade_flow_own_company" model="ir.rule">
        <field name="name">交易流水：仅见本企业流水</field>
        <field name="model_id" ref="model_gz_trade_flow"/>
        <field name="domain_force">[('enterprise_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('gz_platform_base.group_gz_merchant')), (4, ref('gz_platform_base.group_gz_supplier')), (4, ref('gz_platform_base.group_gz_buyer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
