<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 平台批次号：GZ-BATCH-<年>-<5 位流水> -->
        <record id="seq_gz_stock_batch" model="ir.sequence">
            <field name="name">平台库存批次号</field>
            <field name="code">gz.stock.batch</field>
            <field name="prefix">GZ-BATCH-%(year)s-</field>
            <field name="padding">5</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
